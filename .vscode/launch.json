{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Fortran (GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/src/build/xpellet",
      "args": [],
      "stopAtEntry": true,
      "cwd": "${workspaceFolder}/src/build/",
      "MIMode": "gdb",
      "miDebuggerPath": "/opt/homebrew/bin/gdb",
      "externalConsole": true,
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
T]\nno scaling needed real(kind=rspec), intent(out) :: Del_drift plasma elongation close to the separatrix [-]","tags":"","url":"proc/hpi2_drift.html"},{"title":"WRITE_OUT1 – PELLETS","text":"public  subroutine WRITE_OUT1(nout, c_nout, nx, nv, values, names, units, descriptions, k_lr, LABEL) Arguments Type Intent Optional Attributes Name integer, intent(in) :: nout character(len=*), intent(in) :: c_nout integer, intent(in) :: nx integer, intent(in) :: nv real(kind=rspec), intent(in) :: values (nx,nv) character(len=*), intent(in) :: names (nv) character(len=*), intent(in) :: units (nv) character(len=*), intent(in) :: descriptions (nv) integer, intent(in) :: k_lr character(len=*), intent(in), optional :: LABEL","tags":"","url":"proc/write_out1.html"},{"title":"WRITE_C – PELLETS","text":"public  subroutine WRITE_C(nout, n_c, c, n_l) Arguments Type Intent Optional Attributes Name integer, intent(in) :: nout integer, intent(in) :: n_c character(len=*), intent(in) :: c (n_c) integer, intent(in) :: n_l","tags":"","url":"proc/write_c.html"},{"title":"WRITE_IR – PELLETS","text":"public  subroutine WRITE_IR(nout, n_i, i, n_r, r, n_l, k_format) Arguments Type Intent Optional Attributes Name integer, intent(in) :: nout integer, intent(in) :: n_i integer, intent(in) :: i (n_i) integer, intent(in) :: n_r real(kind=rspec), intent(in) :: r (n_r) integer, intent(in) :: n_l integer, intent(in) :: k_format","tags":"","url":"proc/write_ir.html"},{"title":"WRITE_LINE – PELLETS","text":"public  subroutine WRITE_LINE(nout, label, k_above, k_below) Arguments Type Intent Optional Attributes Name integer, intent(in) :: nout character(len=*), intent(in) :: label integer, intent(in) :: k_above integer, intent(in) :: k_below","tags":"","url":"proc/write_line.html"},{"title":"WRITE_LINE_IR – PELLETS","text":"public  subroutine WRITE_LINE_IR(nout, label, n_i, i, n_r, r, n_l, k_format) Arguments Type Intent Optional Attributes Name integer, intent(in) :: nout character(len=*), intent(in) :: label integer, intent(in) :: n_i integer, intent(in) :: i (n_i) integer, intent(in) :: n_r real(kind=rspec), intent(in) :: r (n_r) integer, intent(in) :: n_l integer, intent(in) :: k_format","tags":"","url":"proc/write_line_ir.html"},{"title":"TRACK – PELLETS","text":"public  subroutine TRACK(n_rho, rho, n_seg, r_seg, n_int, irho_int, s_int, iflag, message, K_SEG, IZONE_INT, RFLX_INT, RCYL_INT, RCAR_INT, SDOTB_INT, SDOTPHI_INT) !!!!!!!!!!!!!    -1 added  LB Aug2016 Arguments Type Intent Optional Attributes Name integer, intent(in) :: n_rho real(kind=rspec), intent(in) :: rho (:) integer, intent(in) :: n_seg real(kind=rspec), intent(in) :: r_seg (:,:) integer, intent(out) :: n_int integer, intent(out) :: irho_int (:) real(kind=rspec), intent(out) :: s_int (:) integer, intent(out) :: iflag character(len=*), intent(out) :: message integer, intent(in), optional :: K_SEG integer, intent(out), optional :: IZONE_INT (:) real(kind=rspec), intent(out), optional :: RFLX_INT (:,:) real(kind=rspec), intent(out), optional :: RCYL_INT (:,:) real(kind=rspec), intent(out), optional :: RCAR_INT (:,:) real(kind=rspec), intent(out), optional :: SDOTB_INT (:) real(kind=rspec), intent(out), optional :: SDOTPHI_INT (:)","tags":"","url":"proc/track.html"},{"title":"TRACK_D – PELLETS","text":"public  subroutine TRACK_D(d, r_cars, g_cars, r_flx, r_car, r_cyl, drhods, g_cyl, tau, iflag, message) Arguments Type Intent Optional Attributes Name real(kind=rspec), intent(in) :: d real(kind=rspec), intent(in) :: r_cars (:) real(kind=rspec), intent(in) :: g_cars (:) real(kind=rspec), intent(inout) :: r_flx (:) real(kind=rspec), intent(out) :: r_car (:) real(kind=rspec), intent(out) :: r_cyl (:) real(kind=rspec), intent(out) :: drhods real(kind=rspec), intent(out) :: g_cyl (:) real(kind=rspec), intent(out) :: tau integer, intent(out) :: iflag character(len=*), intent(out) :: message","tags":"","url":"proc/track_d.html"},{"title":"TRACK_G – PELLETS","text":"public  subroutine TRACK_G(r_cyl0, r_cyl1, d, g_car) Arguments Type Intent Optional Attributes Name real(kind=rspec), intent(in) :: r_cyl0 (3) real(kind=rspec), intent(in) :: r_cyl1 (3) real(kind=rspec), intent(out) :: d real(kind=rspec), intent(out) :: g_car (3)","tags":"","url":"proc/track_g.html"},{"title":"PELLET – PELLETS","text":"public  subroutine PELLET(k_pel, amupel, rpel, vpel, n_r, dvol_r, den0_r, te0_r, n_p, map_p, s_p, pden_r, iflag, message, NF, NE_F, IZ_F, AMU_F, E_EF, VC_RF, DEN_REF, PEL_IONS, T_P, RPEL1_P, SRC_P, DEN0_P, DEN1_P, TE0_P, TE1_P, R0, A0, BT0, NCSOL, K_PRL, NPRLCLD, IPRLCLD, FPELPRL, PRLINJANG, PRLQ_R, PRLDEP, K_DRIFT, ALPHA, LAMBDA, KAPPA, DEL_DRIFT) PELLET calculates the ablation profile for solid pellets injected into a plasma References:\n  W.A.Houlberg, S.L.Milora, S.E.Attenberger, Nucl Fusion 28 (1988) 595\n  S.L.Milora, ORNL/TM-8616 (1983)\n  W.A.Houlberg, M.A.Iskra, H.C.Howe, S.E.Attenberger, ORNL/TM-6549 (1979)\n  W.A.Houlberg, L.R.Baylor 6/2004\n  W.A.Houlberg, F90 free format 8/2004\n  L.R. Baylor, Added linkages to PRL model routine, Parks,Baylor, submitted 2004 Declaration of input variables\nHydrogenic molecular density\n Hydrogenic \n Assume hydrogenic ionization energy Check if impurity and adjust denm_pl - divide by 2 since not molecules like H2 * )\nNeon (nominally 20.2)\nArgon (nominally 39.9)\nKrypton (nominally 83.8)\nXenon (nominally 131.0)\nLithium (nominally 6.9)\nkeV Carbon(nominally 12.0)\nkeV Be (nominally 9.0)\nkeV Internal data differing from default\nhydrogenic NGS model: e distribution, elliptical neutral shield\nMilora hydrogenic NGS model: single e energy, spherical neutral shield\nhydrogenic NGPS model: e distribution, 1mm neutral layer thickness\nMacaulay hydrogenic NGS\nKuteev hydrogenic NGS\nParks hydrogenic NGS\nParks hydrogenic NGS-Q\nParks impurity model\nParks impurity model 2012\nKuteev impurity model\nSergeev impurity model 2006\nParks impurity model 2016\nFast ions\nZero output arrays\nSet private pellet parameters for normalizations\nInitialize parameters at beginning of pellet trajectory\n PRL cloudlet counter\nOptional output Follow the pellet path and determine the ablation rate Flag to indicate whether pellet has entered plasma\nFlag to indicate whether pellet has entered and exited plasma\nPellet has not entered plasma yet\nIncrement parameters for path outside plasma\nPellet is inside plasma and never exited\nSet optional output parameters along path\n  Lets total up the electrons put in plasma as a check Call PRL drift model Check to see if cloudlet mass has been ablated away since last cloudlet Check for remaining pellet size to do drift calc\n Increment cloud counters\n Do PRL calculation\nProfile generation\n convert to eV\n convert to cm&#94;-3\nProfile generation rho_p = 1.0-fi/nfloat\nrho_p = lc(l)/fncp\n cm from m\n cm from m\n cm from m\n cm/s from m/s diagnostic output flag\nSave PRL deposition profile and adjust Te profile\nNum pellet particles nea(i) = (fnumpart/neasum)*nea(i)/dvol(i)\nConvert to density\n Determine dep profile Adiabatic approximation\nte(i) = te(i)*den(i)/(den(i) + nea(i))\nden(i) = den(i) + nea(i) Profile generation\n te_r: initial temp profile\n convert to 1e19 1/m**3\n ne_r: initial den profile\n nea_r: den profile after cloudlet motion\n tea_r: temp profile after cloudlet motion\nProfile generation rho_p = 1.0-fi/nfloat\nrho_p = lc(l)/fncp\n mm from m !!!!! !!!!! ned and teb are arrays\n HPI2_DRIFT expects a single integer Pellet has been in the plasma but is now outside\npresent rp>1e-6 PRL deposition profile Done with PRL - determine prldep\n Determine dep profile\n      if (kprl.gt.0) then  !! New output of PRL dep calculation\n         write(nerr, ) ' '\n         write(nerr, ) ' PRL output for num clouds = ', icld\n         do i=1,nc\n           dennew=den(i)+prldep(i)\n           write(nerr,1230) i,den(i),dennew,dvol(i),prldep(i)\n         enddo\n      endif Cleanup and exit Arguments Type Intent Optional Attributes Name integer, intent(in) :: k_pel ablation model [hydrogenic 0-5, impurity 10-11]\n=0 ref NGS MODEL, e distr, ellipt shield\n=1 Milora NGS model, single e energy, spher shield\n=2 NGPS model, e distr, 1mm neutral layer\n=3 Macaulay hydrogenic model\n=4 Kuteev hydrogenic model\n=5 Parks hydrogenic model\n=6 Parks hydrogenic model arbitrary Q\n=10 Parks impurity model\n=12 Parks impurity model 2012\n=11 Kuteev impurity model\n=else failure\nnumber of radial plasma cells [-]\nnumber of segments along pellet path [-] real(kind=rspec), intent(in) :: amupel atomic mass number of pellet atoms [-]\nused for either hydrogenic or impurity pellets\ninitial pellet spherical radius [m]\npellet velocity [m/s] real(kind=rspec), intent(in) :: rpel atomic mass number of pellet atoms [-]\nused for either hydrogenic or impurity pellets\ninitial pellet spherical radius [m]\npellet velocity [m/s] real(kind=rspec), intent(in) :: vpel atomic mass number of pellet atoms [-]\nused for either hydrogenic or impurity pellets\ninitial pellet spherical radius [m]\npellet velocity [m/s] integer, intent(in) :: n_r ablation model [hydrogenic 0-5, impurity 10-11]\n=0 ref NGS MODEL, e distr, ellipt shield\n=1 Milora NGS model, single e energy, spher shield\n=2 NGPS model, e distr, 1mm neutral layer\n=3 Macaulay hydrogenic model\n=4 Kuteev hydrogenic model\n=5 Parks hydrogenic model\n=6 Parks hydrogenic model arbitrary Q\n=10 Parks impurity model\n=12 Parks impurity model 2012\n=11 Kuteev impurity model\n=else failure\nnumber of radial plasma cells [-]\nnumber of segments along pellet path [-] real(kind=rspec), intent(in) :: dvol_r (:) volume of plasma cell i [m 3]\ninitial electron density in radial cells [/m 3]\ninitial electron temperature in radial cells [keV]\ndistance to the beginning of path segment [m]\ns_p(1) is the entry point and can be non-zero Declaration of optional input variables real(kind=rspec), intent(in) :: den0_r (:) volume of plasma cell i [m 3]\ninitial electron density in radial cells [/m 3]\ninitial electron temperature in radial cells [keV]\ndistance to the beginning of path segment [m]\ns_p(1) is the entry point and can be non-zero Declaration of optional input variables real(kind=rspec), intent(in) :: te0_r (:) volume of plasma cell i [m 3]\ninitial electron density in radial cells [/m 3]\ninitial electron temperature in radial cells [keV]\ndistance to the beginning of path segment [m]\ns_p(1) is the entry point and can be non-zero Declaration of optional input variables integer, intent(in) :: n_p ablation model [hydrogenic 0-5, impurity 10-11]\n=0 ref NGS MODEL, e distr, ellipt shield\n=1 Milora NGS model, single e energy, spher shield\n=2 NGPS model, e distr, 1mm neutral layer\n=3 Macaulay hydrogenic model\n=4 Kuteev hydrogenic model\n=5 Parks hydrogenic model\n=6 Parks hydrogenic model arbitrary Q\n=10 Parks impurity model\n=12 Parks impurity model 2012\n=11 Kuteev impurity model\n=else failure\nnumber of radial plasma cells [-]\nnumber of segments along pellet path [-] integer, intent(in) :: map_p (:) plasma cell for each path segment [-] real(kind=rspec), intent(in) :: s_p (:) volume of plasma cell i [m 3]\ninitial electron density in radial cells [/m 3]\ninitial electron temperature in radial cells [keV]\ndistance to the beginning of path segment [m]\ns_p(1) is the entry point and can be non-zero Declaration of optional input variables real(kind=rspec), intent(out) :: pden_r (:) increase in plasma density in radial cells [/m**3] Declaration of optional output variables integer, intent(out) :: iflag error and warning flag [-]\n=-1 warning\n=0 no warnings or errors\n=1 error character(len=*), intent(out) :: message warning or error message [character] integer, intent(in), optional :: NF number of fast ion species (H,D,T,He3,He4) [-]\nnumber of energy groups for fast ions [-]\ncharge of fast ions (1,2) [-]\nNumber of SOL grid points in n_r   [-]\nflag for PRL model calculation \n=0: no drift \n=1: Parks 2000 drift \n=2: Baylor 2007 drift \n=3: HPI2 drift \nNumber of PRL cl
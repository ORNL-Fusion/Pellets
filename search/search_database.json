var tipuesearch = {"pages":[{"title":" PELLETS ","text":"PELLETS The PELLETS code","tags":"home","url":"index.html"},{"title":"SETUP_AJAX – PELLETS","text":"subroutine SETUP_AJAX(k_equil, n_eq, r0, a0, s0, e0, e1, d1, bt0, q0, q1, n_rho, rho, nrho_ajax, ntheta_ajax, nzeta_ajax, iflag, message) Uses AJAX_MOD SPEC_KIND_MOD Arguments Type Intent Optional Attributes Name integer, intent(in) :: k_equil integer, intent(in) :: n_eq real(kind=rspec), intent(in) :: r0 real(kind=rspec), intent(in) :: a0 real(kind=rspec), intent(in) :: s0 real(kind=rspec), intent(in) :: e0 real(kind=rspec), intent(in) :: e1 real(kind=rspec), intent(in) :: d1 real(kind=rspec), intent(in) :: bt0 real(kind=rspec), intent(in) :: q0 real(kind=rspec), intent(in) :: q1 integer, intent(in) :: n_rho real(kind=rspec), intent(in) :: rho (1:n_rho) integer, intent(in) :: nrho_ajax integer, intent(in) :: ntheta_ajax integer, intent(in) :: nzeta_ajax integer, intent(out) :: iflag character(len=*), intent(out) :: message","tags":"","url":"proc/setup_ajax.html"},{"title":"READEQ – PELLETS","text":"subroutine READEQ(n_eq, nrho_ajax, ntheta_ajax, nzeta_ajax, iflag, message) Uses AJAX_MOD SPEC_KIND_MOD Arguments Type Intent Optional Attributes Name integer, intent(in) :: n_eq integer, intent(in) :: nrho_ajax integer, intent(in) :: ntheta_ajax integer, intent(in) :: nzeta_ajax integer, intent(out) :: iflag character(len=*), intent(out) :: message","tags":"","url":"proc/readeq.html"},{"title":"READ_PELLET_PRO – PELLETS","text":"subroutine READ_PELLET_PRO(nin, cin, n_rho, rho_r, den_r, te_r, iflag, message) Uses LINEAR1_MOD SPEC_KIND_MOD Arguments Type Intent Optional Attributes Name integer, intent(in) :: nin character(len=*), intent(in) :: cin integer, intent(in) :: n_rho real(kind=rspec), intent(in) :: rho_r (n_rho) real(kind=rspec), intent(out) :: den_r (n_rho) real(kind=rspec), intent(out) :: te_r (1:n_rho) integer, intent(out) :: iflag character(len=*), intent(out) :: message","tags":"","url":"proc/read_pellet_pro.html"},{"title":"PELLET_EFIT – PELLETS","text":"subroutine PELLET_EFIT(nin, cnin, nr_r, rhot_r, r0, a0, bt0, s0, e0, e1, d1, q0, q1, iflag, message) Uses SPEC_KIND_MOD FLUXAV_MOD Arguments Type Intent Optional Attributes Name integer, intent(in) :: nin character(len=*), intent(in) :: cnin integer, intent(in) :: nr_r real(kind=rspec), intent(in) :: rhot_r (nr_r) real(kind=rspec), intent(out) :: r0 real(kind=rspec), intent(out) :: a0 real(kind=rspec), intent(out) :: bt0 real(kind=rspec), intent(out) :: s0 real(kind=rspec), intent(out) :: e0 real(kind=rspec), intent(out) :: e1 real(kind=rspec), intent(out) :: d1 real(kind=rspec), intent(out) :: q0 real(kind=rspec), intent(out) :: q1 integer, intent(out) :: iflag character(len=*), intent(out) :: message","tags":"","url":"proc/pellet_efit.html"},{"title":"READ_EFIT_EQDSK – PELLETS","text":"subroutine READ_EFIT_EQDSK(nin, cnin, mxnx_xy, mxny_xy, mxn_lim, bt0, cur, psimag, psilim, r0, rmag, zmag, nx_xy, ny_xy, x_xy, y_xy, psi_xy, f_x, ffp_x, psi_x, q_x, rhop_x, n_lim, x_lim, y_lim, iflag, message) Uses SPEC_KIND_MOD Arguments Type Intent Optional Attributes Name integer, intent(in) :: nin character(len=*), intent(in) :: cnin integer, intent(in) :: mxnx_xy integer, intent(in) :: mxny_xy integer, intent(in) :: mxn_lim real(kind=rspec), intent(out) :: bt0 real(kind=rspec), intent(out) :: cur real(kind=rspec), intent(out) :: psimag real(kind=rspec), intent(out) :: psilim real(kind=rspec), intent(out) :: r0 real(kind=rspec), intent(out) :: rmag real(kind=rspec), intent(out) :: zmag integer, intent(out) :: nx_xy integer, intent(out) :: ny_xy real(kind=rspec), intent(out) :: x_xy (mxnx_xy) real(kind=rspec), intent(out) :: y_xy (mxny_xy) real(kind=rspec), intent(out) :: psi_xy (mxnx_xy,mxny_xy) real(kind=rspec), intent(out) :: f_x (mxnx_xy) real(kind=rspec), intent(out) :: ffp_x (mxnx_xy) real(kind=rspec), intent(out) :: psi_x (mxnx_xy) real(kind=rspec), intent(out) :: q_x (mxnx_xy) real(kind=rspec), intent(out) :: rhop_x (mxnx_xy) integer, intent(out) :: n_lim real(kind=rspec), intent(out) :: x_lim (mxn_lim) real(kind=rspec), intent(out) :: y_lim (mxn_lim) integer, intent(out) :: iflag character(len=*), intent(out) :: message","tags":"","url":"proc/read_efit_eqdsk.html"},{"title":"MIRTH_SS – PELLETS","text":"public  subroutine MIRTH_SS(af, izf, e0, p, nr, te, den, zbr, dn0, dvol, h, ng, eg, dg, vc) Arguments Type Intent Optional Attributes Name real(kind=rspec), intent(in) :: af integer, intent(in) :: izf real(kind=rspec), intent(in) :: e0 real(kind=rspec), intent(in) :: p integer, intent(in) :: nr real(kind=rspec), intent(in) :: te (:) real(kind=rspec), intent(in) :: den (:) real(kind=rspec), intent(in) :: zbr (:) real(kind=rspec), intent(in) :: dn0 (:) real(kind=rspec), intent(in) :: dvol (:) real(kind=rspec), intent(in) :: h (:) integer, intent(in) :: ng real(kind=rspec), intent(in) :: eg (:) real(kind=rspec), intent(inout) :: dg (:,:) real(kind=rspec), intent(out) :: vc (:)","tags":"","url":"proc/mirth_ss.html"},{"title":"PRLDATA – PELLETS","text":"public  subroutine PRLDATA() Arguments None","tags":"","url":"proc/prldata.html"},{"title":"LINEAR1_INTERP – PELLETS","text":"public  subroutine LINEAR1_INTERP(n0, x0, y0, n1, x1, y1, iflag, message) Arguments Type Intent Optional Attributes Name integer, intent(in) :: n0 real(kind=rspec), intent(in) :: x0 (:) real(kind=rspec), intent(in) :: y0 (:) integer, intent(in) :: n1 real(kind=rspec), intent(in) :: x1 (:) real(kind=rspec), intent(out) :: y1 (:) integer, intent(out) :: iflag character(len=*), intent(out) :: message","tags":"","url":"proc/linear1_interp.html"},{"title":"LINEAR1_INTEG – PELLETS","text":"public  subroutine LINEAR1_INTEG(k_order, n0, x0, f, n1, x1, value, iflag, message) Arguments Type Intent Optional Attributes Name integer, intent(in) :: k_order integer, intent(in) :: n0 real(kind=rspec), intent(in) :: x0 (:) real(kind=rspec), intent(in) :: f (:) integer, intent(in) :: n1 real(kind=rspec), intent(in) :: x1 (:) real(kind=rspec), intent(out) :: value (:) integer, intent(out) :: iflag character(len=*), intent(out) :: message","tags":"","url":"proc/linear1_integ.html"},{"title":"PRL – PELLETS","text":"public  subroutine PRL(irunid, idiag, Bt, Rm, am, chi0, rpel, rhop, pnum, vpel, n_r, te_r, ne_r, q_r, tea_r, nea_r, rho_r, nump) **\nneinf_pr = 1.0e14\nteinf_pr = 5000.0  !5 kev q0, qa, and qfact have not been given values, obsolete coding\nq(i)=q0+qa (rtw(i) xloc) qfact  !q profile is known\nq(i)=260.0/(Rmtw(i) Rin)  !Keep Rq constant **   &\nCOS((lc_pr/(q_prl(ixloc) rm_pr)) xcenn_pr(i)) COS((lc_pr xintn_pr(i)/(q_prl(ixloc) rm_pr)) xcenn_pr(i)) Eqn 25 of PoP 2000\n Note this is psi_twiddle - see PoP2000 Eqn 25. **\nteinf_pr = 5000.0\nneinf_pr = 1.0e14 **          qhatt=qhat_pr Arguments Type Intent Optional Attributes Name integer, intent(in) :: irunid integer, intent(in) :: idiag real(kind=rspec), intent(in) :: Bt real(kind=rspec), intent(in) :: Rm real(kind=rspec), intent(in) :: am real(kind=rspec), intent(in) :: chi0 real(kind=rspec), intent(in) :: rpel real(kind=rspec), intent(in) :: rhop real(kind=rspec), intent(in) :: pnum real(kind=rspec), intent(in) :: vpel integer, intent(in) :: n_r real(kind=rspec), intent(in) :: te_r (:) real(kind=rspec), intent(in) :: ne_r (:) real(kind=rspec), intent(in) :: q_r (:) real(kind=rspec), intent(out) :: tea_r (:) real(kind=rspec), intent(out) :: nea_r (:) real(kind=rspec), intent(in) :: rho_r (:) real(kind=rspec), intent(out) :: nump","tags":"","url":"proc/prl.html"},{"title":"X_SIG_FUS – PELLETS","text":"public  function X_SIG_FUS(vrel, k_reaction) Arguments Type Intent Optional Attributes Name real(kind=rspec), intent(in) :: vrel integer, intent(in) :: k_reaction Return Value real(kind=rspec)","tags":"","url":"proc/x_sig_fus.html"},{"title":"X_SIG_PE – PELLETS","text":"public  function X_SIG_PE(e) Arguments Type Intent Optional Attributes Name real(kind=rspec), intent(in) :: e Return Value real(kind=rspec)","tags":"","url":"proc/x_sig_pe.html"},{"title":"X_SIG_PI – PELLETS","text":"public  function X_SIG_PI(e, ai) Arguments Type Intent Optional Attributes Name real(kind=rspec), intent(in) :: e real(kind=rspec), intent(in) :: ai Return Value real(kind=rspec)","tags":"","url":"proc/x_sig_pi.html"},{"title":"X_SIG_PX – PELLETS","text":"public  function X_SIG_PX(e, ai) Arguments Type Intent Optional Attributes Name real(kind=rspec), intent(in) :: e real(kind=rspec), intent(in) :: ai Return Value real(kind=rspec)","tags":"","url":"proc/x_sig_px.html"},{"title":"X_SIG_ZI – PELLETS","text":"public  function X_SIG_ZI(e, an, zi) Arguments Type Intent Optional Attributes Name real(kind=rspec), intent(in) :: e real(kind=rspec), intent(in) :: an real(kind=rspec), intent(in) :: zi Return Value real(kind=rspec)","tags":"","url":"proc/x_sig_zi.html"},{"title":"X_SIGV_FUS – PELLETS","text":"public  function X_SIGV_FUS(ti, k_reaction) Arguments Type Intent Optional Attributes Name real(kind=rspec), intent(in) :: ti integer, intent(in) :: k_reaction Return Value real(kind=rspec)","tags":"","url":"proc/x_sigv_fus.html"},{"title":"X_SIGV_PE – PELLETS","text":"public  function X_SIGV_PE(te, en, an) Arguments Type Intent Optional Attributes Name real(kind=rspec), intent(in) :: te real(kind=rspec), intent(in) :: en real(kind=rspec), intent(in) :: an Return Value real(kind=rspec)","tags":"","url":"proc/x_sigv_pe.html"},{"title":"X_SIGV_PI – PELLETS","text":"public  function X_SIGV_PI(ti, en, ai, an) Arguments Type Intent Optional Attributes Name real(kind=rspec), intent(in) :: ti real(kind=rspec), intent(in) :: en real(kind=rspec), intent(in) :: ai real(kind=rspec), intent(in) :: an Return Value real(kind=rspec)","tags":"","url":"proc/x_sigv_pi.html"},{"title":"X_SIGV_PX – PELLETS","text":"public  function X_SIGV_PX(ti, en, ai, an) Arguments Type Intent Optional Attributes Name real(kind=rspec), intent(in) :: ti real(kind=rspec), intent(in) :: en real(kind=rspec), intent(in) :: ai real(kind=rspec), intent(in) :: an Return Value real(kind=rspec)","tags":"","url":"proc/x_sigv_px.html"},{"title":"X_SIGV_RC – PELLETS","text":"public  function X_SIGV_RC(te) Arguments Type Intent Optional Attributes Name real(kind=rspec), intent(in) :: te Return Value real(kind=rspec)","tags":"","url":"proc/x_sigv_rc.html"},{"title":"SPLINE1_FIT – PELLETS","text":"public  subroutine SPLINE1_FIT(n, x, f, K_BC1, K_BCN) Arguments Type Intent Optional Attributes Name integer, intent(in) :: n real(kind=rspec), intent(in) :: x (:) real(kind=rspec), intent(inout) :: f (:,:) integer, intent(in), optional :: K_BC1 integer, intent(in), optional :: K_BCN","tags":"","url":"proc/spline1_fit.html"},{"title":"SPLINE1_EVAL – PELLETS","text":"public  subroutine SPLINE1_EVAL(k_vopt, n, u, x, f, i, value) Arguments Type Intent Optional Attributes Name integer, intent(in) :: k_vopt (:) integer, intent(in) :: n real(kind=rspec), intent(in) :: u real(kind=rspec), intent(in) :: x (:) real(kind=rspec), intent(in) :: f (:,:) integer, intent(inout) :: i real(kind=rspec), intent(out) :: value (:)","tags":"","url":"proc/spline1_eval.html"},{"title":"SPLINE1_INTERP – PELLETS","text":"public  subroutine SPLINE1_INTERP(k_vopt, n0, x0, f, n1, x1, value, iflag, message, K_BC1, K_BCN) Arguments Type Intent Optional Attributes Name integer, intent(in) :: k_vopt (:) integer, intent(in) :: n0 real(kind=rspec), intent(in) :: x0 (:) real(kind=rspec), intent(inout) :: f (:,:) integer, intent(in) :: n1 real(kind=rspec), intent(in) :: x1 (:) real(kind=rspec), intent(out) :: value (:,:) integer, intent(out) :: iflag character(len=*), intent(out) :: message integer, intent(in), optional :: K_BC1 integer, intent(in), optional :: K_BCN","tags":"","url":"proc/spline1_interp.html"},{"title":"SPLINE1_INTEG – PELLETS","text":"public  subroutine SPLINE1_INTEG(k_order, n0, x0, f, n1, x1, value, iflag, message) Arguments Type Intent Optional Attributes Name integer, intent(in) :: k_order integer, intent(in) :: n0 real(kind=rspec), intent(in) :: x0 (:) real(kind=rspec), intent(in) :: f (:,:) integer, intent(in) :: n1 real(kind=rspec), intent(in) :: x1 (:) real(kind=rspec), intent(out) :: value (:) integer, intent(out) :: iflag character(len=*), intent(out) :: message","tags":"","url":"proc/spline1_integ.html"},{"title":"PARKS_DRIFT – PELLETS","text":"public  subroutine PARKS_DRIFT(W, r_p, ne_inf, Te_inf, R, B, M0, T0, cA_inf, beta_inf, kap_c, beta_ratio, Sigma_0, c_0_bar, Psi_int, DelR) PARKS_DRIFT calculates the change in pellet position Delta R\n based on an ad-hoc scaling law.\n See Parks et al. (2000) We use the same convention as Parks but also include the\n corresponding PELLET parameters along with their units. ------------------------------------------------------------------#\n Calculating scalar quantities\n------------------------------------------------------------------# Calculate sonic radius quantities Beta and temperatures at the sonic radius r_star_prime, which is the\n transition from sub- to super-sonic velocity, r_star_prime ~ 1.6r_p. temperature where M = 1 background plasma Alfven velocity assuming quasi-neutrality Quantities at channel entrance Dimensionless quantities at channel entrance For the life of me I cannot get Sigma_0 to match the paper value...\n which is leading to a final DelR 50% larger than it should be. Toroidal drive integral This expression is valid only for beta_ratio < 10\n Can add extended definition later on Penetration depth (Eq. 28) Arguments Type Intent Optional Attributes Name real(kind=rspec), intent(in) :: W pellet mass in amu [-]\nPELLET: amu_pel [-] \npellet radius [cm]\nPELLET: r0 [m]\nscale input by 1.0E2\nbackground plasma density [/cm 3]\nPELLET: den0 [/m 3]\nscale input by 1.0E6\nbackground plasma temperature [keV]\nPELLET: te0 [keV]\nno scaling\nmajor radius [m]\nPELLET: r0 [m]\nno scaling\ntoroidal magnetic field [T]\nPELLET: bt0 [T]\nno scaling\nmach number at the channel entrance [-]\nPELLET: NA\ntemperature at the channel entrance [eV]\nPELLET: NA real(kind=rspec), intent(in) :: r_p pellet mass in amu [-]\nPELLET: amu_pel [-] \npellet radius [cm]\nPELLET: r0 [m]\nscale input by 1.0E2\nbackground plasma density [/cm 3]\nPELLET: den0 [/m 3]\nscale input by 1.0E6\nbackground plasma temperature [keV]\nPELLET: te0 [keV]\nno scaling\nmajor radius [m]\nPELLET: r0 [m]\nno scaling\ntoroidal magnetic field [T]\nPELLET: bt0 [T]\nno scaling\nmach number at the channel entrance [-]\nPELLET: NA\ntemperature at the channel entrance [eV]\nPELLET: NA real(kind=rspec), intent(in) :: ne_inf pellet mass in amu [-]\nPELLET: amu_pel [-] \npellet radius [cm]\nPELLET: r0 [m]\nscale input by 1.0E2\nbackground plasma density [/cm 3]\nPELLET: den0 [/m 3]\nscale input by 1.0E6\nbackground plasma temperature [keV]\nPELLET: te0 [keV]\nno scaling\nmajor radius [m]\nPELLET: r0 [m]\nno scaling\ntoroidal magnetic field [T]\nPELLET: bt0 [T]\nno scaling\nmach number at the channel entrance [-]\nPELLET: NA\ntemperature at the channel entrance [eV]\nPELLET: NA real(kind=rspec), intent(in) :: Te_inf pellet mass in amu [-]\nPELLET: amu_pel [-] \npellet radius [cm]\nPELLET: r0 [m]\nscale input by 1.0E2\nbackground plasma density [/cm 3]\nPELLET: den0 [/m 3]\nscale input by 1.0E6\nbackground plasma temperature [keV]\nPELLET: te0 [keV]\nno scaling\nmajor radius [m]\nPELLET: r0 [m]\nno scaling\ntoroidal magnetic field [T]\nPELLET: bt0 [T]\nno scaling\nmach number at the channel entrance [-]\nPELLET: NA\ntemperature at the channel entrance [eV]\nPELLET: NA real(kind=rspec), intent(in) :: R pellet mass in amu [-]\nPELLET: amu_pel [-] \npellet radius [cm]\nPELLET: r0 [m]\nscale input by 1.0E2\nbackground plasma density [/cm 3]\nPELLET: den0 [/m 3]\nscale input by 1.0E6\nbackground plasma temperature [keV]\nPELLET: te0 [keV]\nno scaling\nmajor radius [m]\nPELLET: r0 [m]\nno scaling\ntoroidal magnetic field [T]\nPELLET: bt0 [T]\nno scaling\nmach number at the channel entrance [-]\nPELLET: NA\ntemperature at the channel entrance [eV]\nPELLET: NA real(kind=rspec), intent(in) :: B pellet mass in amu [-]\nPELLET: amu_pel [-] \npellet radius [cm]\nPELLET: r0 [m]\nscale input by 1.0E2\nbackground plasma density [/cm 3]\nPELLET: den0 [/m 3]\nscale input by 1.0E6\nbackground plasma temperature [keV]\nPELLET: te0 [keV]\nno scaling\nmajor radius [m]\nPELLET: r0 [m]\nno scaling\ntoroidal magnetic field [T]\nPELLET: bt0 [T]\nno scaling\nmach number at the channel entrance [-]\nPELLET: NA\ntemperature at the channel entrance [eV]\nPELLET: NA real(kind=rspec), intent(in) :: M0 pellet mass in amu [-]\nPELLET: amu_pel [-] \npellet radius [cm]\nPELLET: r0 [m]\nscale input by 1.0E2\nbackground plasma density [/cm 3]\nPELLET: den0 [/m 3]\nscale input by 1.0E6\nbackground plasma temperature [keV]\nPELLET: te0 [keV]\nno scaling\nmajor radius [m]\nPELLET: r0 [m]\nno scaling\ntoroidal magnetic field [T]\nPELLET: bt0 [T]\nno scaling\nmach number at the channel entrance [-]\nPELLET: NA\ntemperature at the channel entrance [eV]\nPELLET: NA real(kind=rspec), intent(in) :: T0 pellet mass in amu [-]\nPELLET: amu_pel [-] \npellet radius [cm]\nPELLET: r0 [m]\nscale input by 1.0E2\nbackground plasma density [/cm 3]\nPELLET: den0 [/m 3]\nscale input by 1.0E6\nbackground plasma temperature [keV]\nPELLET: te0 [keV]\nno scaling\nmajor radius [m]\nPELLET: r0 [m]\nno scaling\ntoroidal magnetic field [T]\nPELLET: bt0 [T]\nno scaling\nmach number at the channel entrance [-]\nPELLET: NA\ntemperature at the channel entrance [eV]\nPELLET: NA real(kind=rspec), intent(out) :: cA_inf Currently these out quantities are just to compare with\n the calculations in Parks et al. (2000)\n------------------------------------------------------------------#\n background plasma beta Alfven velocity of background plasma\n normalized cloud opacity (?) (dimensionless)\n ratio of channel entrance and  background plasma betas\n kap_c == r_perp/r_p\n toroidal drive integral\n final penetration depth real(kind=rspec), intent(out) :: beta_inf Currently these out quantities are just to compare with\n the calculations in Parks et al. (2000)\n------------------------------------------------------------------#\n background plasma beta Alfven velocity of background plasma\n normalized cloud opacity (?) (dimensionless)\n ratio of channel entrance and  background plasma betas\n kap_c == r_perp/r_p\n toroidal drive integral\n final penetration depth real(kind=rspec), intent(out) :: kap_c Currently these out quantities are just to compare with\n the calculations in Parks et al. (2000)\n------------------------------------------------------------------#\n background plasma beta Alfven velocity of background plasma\n normalized cloud opacity (?) (dimensionless)\n ratio of channel entrance and  background plasma betas\n kap_c == r_perp/r_p\n toroidal drive integral\n final penetration depth real(kind=rspec), intent(out) :: beta_ratio Currently these out quantities are just to compare with\n the calculations in Parks et al. (2000)\n------------------------------------------------------------------#\n background plasma beta Alfven velocity of background plasma\n normalized cloud opacity (?) (dimensionless)\n ratio of channel entrance and  background plasma betas\n kap_c == r_perp/r_p\n toroidal drive integral\n final penetration depth real(kind=rspec), intent(out) :: Sigma_0 Currently these out quantities are just to compare with\n the calculations in Parks et al. (2000)\n------------------------------------------------------------------#\n background plasma beta Alfven velocity of background plasma\n normalized cloud opacity (?) (dimensionless)\n ratio of channel entrance and  background plasma betas\n kap_c == r_perp/r_p\n toroidal drive integral\n final penetration depth real(kind=rspec), intent(out) :: c_0_bar Currently these out quantities are just to compare with\n the calculations in Parks et al. (2000)\n------------------------------------------------------------------#\n background plasma beta Alfven velocity of background plasma\n normalized cloud opacity (?) (dimensionless)\n ratio of channel entrance and  background plasma betas\n kap_c == r_perp/r_p\n toroidal drive integral\n final penetration depth real(kind=rspec), intent(out) :: Psi_int Currently these out quantities are just to compare with\n the calculations in Parks et al. (2000)\n------------------------------------------------------------------#\n background plasma beta Alfven velocity of background plasma\n normalized cloud opacity (?) (dimensionless)\n ratio of channel entrance and  background plasma betas\n kap_c == r_perp/r_p\n toroidal drive integral\n final penetration depth real(kind=rspec), intent(out) :: DelR Currently these out quantities are just to compare with\n the calculations in Parks et al. (2000)\n------------------------------------------------------------------#\n background plasma beta Alfven velocity of background plasma\n normalized cloud opacity (?) (dimensionless)\n ratio of channel entrance and  background plasma betas\n kap_c == r_perp/r_p\n toroidal drive integral\n final penetration depth","tags":"","url":"proc/parks_drift.html"},{"title":"BAYLOR_DRIFT – PELLETS","text":"public  subroutine BAYLOR_DRIFT(B, Te0, Teped, r_pel, qa, DelR) Arguments Type Intent Optional Attributes Name real(kind=rspec), intent(in) :: B magnetic field [T] \ncentral electron temp [keV]\npedestal electron temp [keV]\npellet radius [m]\nsafety factor at the edge real(kind=rspec), intent(in) :: Te0 magnetic field [T] \ncentral electron temp [keV]\npedestal electron temp [keV]\npellet radius [m]\nsafety factor at the edge real(kind=rspec), intent(in) :: Teped magnetic field [T] \ncentral electron temp [keV]\npedestal electron temp [keV]\npellet radius [m]\nsafety factor at the edge real(kind=rspec), intent(in) :: r_pel magnetic field [T] \ncentral electron temp [keV]\npedestal electron temp [keV]\npellet radius [m]\nsafety factor at the edge real(kind=rspec), intent(in) :: qa magnetic field [T] \ncentral electron temp [keV]\npedestal electron temp [keV]\npellet radius [m]\nsafety factor at the edge real(kind=rspec), intent(out) :: DelR drift radius","tags":"","url":"proc/baylor_drift.html"},{"title":"HPI2_DRIFT – PELLETS","text":"public  subroutine HPI2_DRIFT(v_p, r_p, ne0, Te0, alpha, Lambda, a0, r0, B0, kappa, Del_drift) Arguments Type Intent Optional Attributes Name real(kind=rspec), intent(in) :: v_p pellet velocity [m/s]\ninput velocity from PELLET in [m/s]\nno scaling needed\npellet radius [mm]\ninput pellet radius from PELLET in [m]\nso scale input by 1.0E3.\naxial electron density [1E19 1/m 3]\ninput ne0 from PELLET in [1/m 3]\nso scale input by 1.0E-19.\naxial electron temperature [keV]\ninput Te0 from PELLET [keV]\nno scaling needed\npellet injection angle w.r.t the horizontal\noutward direction in range [-pi, pi]\ninput from PELLET NA.\n\"impact parameter of the pellet trajectory\" [-]\ninput from PELLET NA.\nminor radius [m]\ninput a0 from PELLET in [m]\nno scaling needed\nmajor radius [m]\ninput r0 from PELLET in [m]\nno scaling needed\ntoroidal field strength [T]\ninput B0 from PELLET in [T]\nno scaling needed real(kind=rspec), intent(in) :: r_p pellet velocity [m/s]\ninput velocity from PELLET in [m/s]\nno scaling needed\npellet radius [mm]\ninput pellet radius from PELLET in [m]\nso scale input by 1.0E3.\naxial electron density [1E19 1/m 3]\ninput ne0 from PELLET in [1/m 3]\nso scale input by 1.0E-19.\naxial electron temperature [keV]\ninput Te0 from PELLET [keV]\nno scaling needed\npellet injection angle w.r.t the horizontal\noutward direction in range [-pi, pi]\ninput from PELLET NA.\n\"impact parameter of the pellet trajectory\" [-]\ninput from PELLET NA.\nminor radius [m]\ninput a0 from PELLET in [m]\nno scaling needed\nmajor radius [m]\ninput r0 from PELLET in [m]\nno scaling needed\ntoroidal field strength [T]\ninput B0 from PELLET in [T]\nno scaling needed real(kind=rspec), intent(in) :: ne0 pellet velocity [m/s]\ninput velocity from PELLET in [m/s]\nno scaling needed\npellet radius [mm]\ninput p
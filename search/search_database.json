, i, n_r, r, n_l, k_format) Arguments Type Intent Optional Attributes Name integer, intent(in) :: nout character(len=*), intent(in) :: label integer, intent(in) :: n_i integer, intent(in) :: i (n_i) integer, intent(in) :: n_r real(kind=rspec), intent(in) :: r (n_r) integer, intent(in) :: n_l integer, intent(in) :: k_format","tags":"","url":"module/write_mod.html"},{"title":"TRACK_MOD – PELLETS","text":"Uses AJAX_MOD SPEC_KIND_MOD Subroutines public  subroutine TRACK (n_rho, rho, n_seg, r_seg, n_int, irho_int, s_int, iflag, message, K_SEG, IZONE_INT, RFLX_INT, RCYL_INT, RCAR_INT, SDOTB_INT, SDOTPHI_INT) !!!!!!!!!!!!!    -1 added  LB Aug2016 Arguments Type Intent Optional Attributes Name integer, intent(in) :: n_rho real(kind=rspec), intent(in) :: rho (:) integer, intent(in) :: n_seg real(kind=rspec), intent(in) :: r_seg (:,:) integer, intent(out) :: n_int integer, intent(out) :: irho_int (:) real(kind=rspec), intent(out) :: s_int (:) integer, intent(out) :: iflag character(len=*), intent(out) :: message integer, intent(in), optional :: K_SEG integer, intent(out), optional :: IZONE_INT (:) real(kind=rspec), intent(out), optional :: RFLX_INT (:,:) real(kind=rspec), intent(out), optional :: RCYL_INT (:,:) real(kind=rspec), intent(out), optional :: RCAR_INT (:,:) real(kind=rspec), intent(out), optional :: SDOTB_INT (:) real(kind=rspec), intent(out), optional :: SDOTPHI_INT (:) public  subroutine TRACK_D (d, r_cars, g_cars, r_flx, r_car, r_cyl, drhods, g_cyl, tau, iflag, message) Arguments Type Intent Optional Attributes Name real(kind=rspec), intent(in) :: d real(kind=rspec), intent(in) :: r_cars (:) real(kind=rspec), intent(in) :: g_cars (:) real(kind=rspec), intent(inout) :: r_flx (:) real(kind=rspec), intent(out) :: r_car (:) real(kind=rspec), intent(out) :: r_cyl (:) real(kind=rspec), intent(out) :: drhods real(kind=rspec), intent(out) :: g_cyl (:) real(kind=rspec), intent(out) :: tau integer, intent(out) :: iflag character(len=*), intent(out) :: message public  subroutine TRACK_G (r_cyl0, r_cyl1, d, g_car) Arguments Type Intent Optional Attributes Name real(kind=rspec), intent(in) :: r_cyl0 (3) real(kind=rspec), intent(in) :: r_cyl1 (3) real(kind=rspec), intent(out) :: d real(kind=rspec), intent(out) :: g_car (3)","tags":"","url":"module/track_mod.html"},{"title":"PELLET_MOD – PELLETS","text":"PELLET_MOD is an F90 module of routines that calculates the ablation of solid\n  hydrogenic or impurity pellets in a plasma References: W.A.Houlberg, L.R.Baylor 6/2004\n  W.A.Houlberg, F90 free format 8/2004 Contains PUBLIC routine: PELLET   - solves for pellet ablation along a trajectory in a plasma Private procedures hydrogenic ablation rate for Kuteev model impurity ablation rate for Kuteev model\nimpurity ablation rate for Sergeev model\nhydrogenic ablation rate for Macaulay model\nhydrogenic  ablation rate for NGS model\nauxiliary ablation routine for NGS model\nelectron heat flux at pellet surface for NGS model\nfast ion heat flux at pellet surface for NGS model\nhydrogenic ablation rate for Parks model\nhydrogenic ablation rate for Parks model arbitrary Q\nimpurity ablation rate for Parks model\nimpurity ablation rate for Parks 2012 model impurity ablation rate for Parks 2016 model for Li, Be, B\n4th order Runge Kutta routine for time stepping Private data Uses PRL_MOD DRIFTS_MOD SPEC_KIND_MOD Subroutines public  subroutine PELLET (k_pel, amupel, rpel, vpel, n_r, dvol_r, den0_r, te0_r, n_p, map_p, s_p, pden_r, iflag, message, NF, NE_F, IZ_F, AMU_F, E_EF, VC_RF, DEN_REF, PEL_IONS, T_P, RPEL1_P, SRC_P, DEN0_P, DEN1_P, TE0_P, TE1_P, R0, A0, BT0, NCSOL, K_PRL, NPRLCLD, IPRLCLD, FPELPRL, PRLINJANG, PRLQ_R, PRLDEP, K_DRIFT, ALPHA, LAMBDA, KAPPA, DEL_DRIFT) PELLET calculates the ablation profile for solid pellets injected into a plasma Read more… Arguments Type Intent Optional Attributes Name integer, intent(in) :: k_pel ablation model [hydrogenic 0-5, impurity 10-11]\n=0 ref NGS MODEL, e distr, ellipt shield\n=1 Milora NGS model, single e energy, spher shield\n=2 NGPS model, e distr, 1mm neutral layer\n=3 Macaulay hydrogenic model\n=4 Kuteev hydrogenic model\n=5 Parks hydrogenic model\n=6 Parks hydrogenic model arbitrary Q\n=10 Parks impurity model\n=12 Parks impurity model 2012\n=11 Kuteev impurity model\n=else failure\nnumber of radial plasma cells [-]\nnumber of segments along pellet path [-] real(kind=rspec), intent(in) :: amupel atomic mass number of pellet atoms [-]\nused for either hydrogenic or impurity pellets\ninitial pellet spherical radius [m]\npellet velocity [m/s] real(kind=rspec), intent(in) :: rpel atomic mass number of pellet atoms [-]\nused for either hydrogenic or impurity pellets\ninitial pellet spherical radius [m]\npellet velocity [m/s] real(kind=rspec), intent(in) :: vpel atomic mass number of pellet atoms [-]\nused for either hydrogenic or impurity pellets\ninitial pellet spherical radius [m]\npellet velocity [m/s] integer, intent(in) :: n_r ablation model [hydrogenic 0-5, impurity 10-11]\n=0 ref NGS MODEL, e distr, ellipt shield\n=1 Milora NGS model, single e energy, spher shield\n=2 NGPS model, e distr, 1mm neutral layer\n=3 Macaulay hydrogenic model\n=4 Kuteev hydrogenic model\n=5 Parks hydrogenic model\n=6 Parks hydrogenic model arbitrary Q\n=10 Parks impurity model\n=12 Parks impurity model 2012\n=11 Kuteev impurity model\n=else failure\nnumber of radial plasma cells [-]\nnumber of segments along pellet path [-] real(kind=rspec), intent(in) :: dvol_r (:) volume of plasma cell i [m 3]\ninitial electron density in radial cells [/m 3]\ninitial electron temperature in radial cells [keV]\ndistance to the beginning of path segment [m]\ns_p(1) is the entry point and can be non-zero Read more… real(kind=rspec), intent(in) :: den0_r (:) volume of plasma cell i [m 3]\ninitial electron density in radial cells [/m 3]\ninitial electron temperature in radial cells [keV]\ndistance to the beginning of path segment [m]\ns_p(1) is the entry point and can be non-zero Read more… real(kind=rspec), intent(in) :: te0_r (:) volume of plasma cell i [m 3]\ninitial electron density in radial cells [/m 3]\ninitial electron temperature in radial cells [keV]\ndistance to the beginning of path segment [m]\ns_p(1) is the entry point and can be non-zero Read more… integer, intent(in) :: n_p ablation model [hydrogenic 0-5, impurity 10-11]\n=0 ref NGS MODEL, e distr, ellipt shield\n=1 Milora NGS model, single e energy, spher shield\n=2 NGPS model, e distr, 1mm neutral layer\n=3 Macaulay hydrogenic model\n=4 Kuteev hydrogenic model\n=5 Parks hydrogenic model\n=6 Parks hydrogenic model arbitrary Q\n=10 Parks impurity model\n=12 Parks impurity model 2012\n=11 Kuteev impurity model\n=else failure\nnumber of radial plasma cells [-]\nnumber of segments along pellet path [-] integer, intent(in) :: map_p (:) plasma cell for each path segment [-] real(kind=rspec), intent(in) :: s_p (:) volume of plasma cell i [m 3]\ninitial electron density in radial cells [/m 3]\ninitial electron temperature in radial cells [keV]\ndistance to the beginning of path segment [m]\ns_p(1) is the entry point and can be non-zero Read more… real(kind=rspec), intent(out) :: pden_r (:) increase in plasma density in radial cells [/m**3] Read more… integer, intent(out) :: iflag error and warning flag [-]\n=-1 warning\n=0 no warnings or errors\n=1 error character(len=*), intent(out) :: message warning or error message [character] integer, intent(in), optional :: NF number of fast ion species (H,D,T,He3,He4) [-]\nnumber of energy groups for fast ions [-]\ncharge of fast ions (1,2) [-]\nNumber of SOL grid points in n_r   [-]\nflag for PRL model calculation \n=0: no drift \n=1: Parks 2000 drift \n=2: Baylor 2007 drift \n=3: HPI2 drift \nNumber of PRL cloudlets from pellet [-]\nID number of PRL cloudlet for diag output [-]\nflag for drift scalings\ninjection angle for HPI2 drift\n.. for HPI2 drift\nplasma elongation integer, intent(in), optional :: NE_F (:) number of fast ion species (H,D,T,He3,He4) [-]\n